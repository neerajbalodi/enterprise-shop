// Fully automated pipeline: provision infra (Terraform) -> build & push images
// -> deploy data layer + app (Helm) -> smoke test. One trigger does everything.
//
// Prerequisites on the Jenkins agent: docker, aws-cli, kubectl, helm, terraform, git.
// Jenkins credential required: 'aws-creds' (AWS access key/secret with admin-ish rights).

pipeline {
    agent any

    parameters {
        choice(name: 'ACTION',      choices: ['deploy', 'destroy'], description: 'Deploy everything, or tear it all down')
        choice(name: 'ENVIRONMENT', choices: ['dev', 'prod'],       description: 'Target environment / namespace')
        booleanParam(name: 'MANAGE_DATA', defaultValue: false,      description: 'Provision managed RDS/MSK/ElastiCache (advanced) instead of in-cluster data')
        string(name: 'AWS_REGION',  defaultValue: 'ap-south-1',     description: 'AWS region')
        password(name: 'DB_PASSWORD', defaultValue: 'shopDemoPassword123!',                       description: 'Postgres password')
        password(name: 'JWT_SECRET',  defaultValue: 'change-me-in-prod-this-is-a-demo-secret-key-32b+', description: 'JWT signing secret (>= 32 chars)')
    }

    environment {
        PROJECT     = 'enterprise-shop'
        AWS_REGION  = "${params.AWS_REGION}"
        NS          = "shop-${params.ENVIRONMENT}"
        TAG         = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : 'latest'}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Build & Test') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                sh '''
                    docker run --rm -v "$WORKSPACE":/w -w /w \
                      maven:3.9-eclipse-temurin-21 mvn -q clean package -DskipTests
                '''
            }
        }

        stage('Provision Infra (Terraform)') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    dir('infra/terraform') {
                        sh '''
                            set -e
                            ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                            BUCKET="${PROJECT}-tfstate-${ACCOUNT_ID}"
                            TABLE="${PROJECT}-tflock"

                            # One-time remote-state backend (idempotent)
                            aws s3api head-bucket --bucket "$BUCKET" 2>/dev/null || \
                              aws s3api create-bucket --bucket "$BUCKET" --region "$AWS_REGION" \
                                --create-bucket-configuration LocationConstraint="$AWS_REGION"
                            aws dynamodb describe-table --table-name "$TABLE" >/dev/null 2>&1 || \
                              aws dynamodb create-table --table-name "$TABLE" \
                                --attribute-definitions AttributeName=LockID,AttributeType=S \
                                --key-schema AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST --region "$AWS_REGION"

                            cat > backend.tf <<EOT
terraform {
  backend "s3" {
    bucket         = "${BUCKET}"
    key            = "${ENVIRONMENT}/terraform.tfstate"
    region         = "${AWS_REGION}"
    dynamodb_table = "${TABLE}"
  }
}
EOT
                            terraform init -reconfigure -input=false
                            terraform apply -auto-approve -input=false \
                              -var="region=${AWS_REGION}" \
                              -var="environment=${ENVIRONMENT}" \
                              -var="manage_data=${MANAGE_DATA}" \
                              -var="db_password=${DB_PASSWORD}"
                        '''
                        script {
                            env.ECR_REGISTRY = sh(script: 'cd "$WORKSPACE/infra/terraform" && terraform output -raw ecr_registry', returnStdout: true).trim()
                            env.CLUSTER_NAME = sh(script: 'cd "$WORKSPACE/infra/terraform" && terraform output -raw cluster_name', returnStdout: true).trim()
                        }
                    }
                }
            }
        }

        stage('Configure kubectl') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh 'aws eks update-kubeconfig --name "$CLUSTER_NAME" --region "$AWS_REGION"'
                }
            }
        }

        stage('Build & Push Images') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh '''
                        set -e
                        aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                        for svc in api-gateway user-service product-service order-service payment-service notification-service; do
                            docker build -f services/$svc/Dockerfile -t "$ECR_REGISTRY/enterprise-shop/$svc:$TAG" .
                            docker push "$ECR_REGISTRY/enterprise-shop/$svc:$TAG"
                        done
                        docker build -f frontend/Dockerfile -t "$ECR_REGISTRY/enterprise-shop/frontend:$TAG" frontend
                        docker push "$ECR_REGISTRY/enterprise-shop/frontend:$TAG"
                    '''
                }
            }
        }

        stage('Namespace, Secrets & Data layer') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                sh '''
                    set -e
                    kubectl create namespace "$NS" --dry-run=client -o yaml | kubectl apply -f -
                    kubectl -n "$NS" create secret generic shop-secrets \
                      --from-literal=POSTGRES_USER=shop \
                      --from-literal=POSTGRES_PASSWORD="$DB_PASSWORD" \
                      --from-literal=JWT_SECRET="$JWT_SECRET" \
                      --dry-run=client -o yaml | kubectl apply -f -
                    kubectl -n "$NS" apply -f k8s/infra
                    kubectl -n "$NS" rollout status deploy/postgres --timeout=180s
                    kubectl -n "$NS" rollout status deploy/kafka --timeout=180s
                '''
            }
        }

        stage('Deploy App (Helm)') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                dir('helm/umbrella') {
                    sh '''
                        set -e
                        helm dependency update
                        helm upgrade --install shop . \
                          -f values.yaml -f values-${ENVIRONMENT}.yaml \
                          --namespace "$NS" \
                          --set apiGateway.image.repository=$ECR_REGISTRY/enterprise-shop/api-gateway           --set apiGateway.image.tag=$TAG \
                          --set userService.image.repository=$ECR_REGISTRY/enterprise-shop/user-service         --set userService.image.tag=$TAG \
                          --set productService.image.repository=$ECR_REGISTRY/enterprise-shop/product-service   --set productService.image.tag=$TAG \
                          --set orderService.image.repository=$ECR_REGISTRY/enterprise-shop/order-service       --set orderService.image.tag=$TAG \
                          --set paymentService.image.repository=$ECR_REGISTRY/enterprise-shop/payment-service   --set paymentService.image.tag=$TAG \
                          --set notificationService.image.repository=$ECR_REGISTRY/enterprise-shop/notification-service --set notificationService.image.tag=$TAG \
                          --set frontend.image.repository=$ECR_REGISTRY/enterprise-shop/frontend                --set frontend.image.tag=$TAG \
                          --wait --timeout 10m
                    '''
                }
            }
        }

        stage('Smoke Test') {
            when { expression { params.ACTION == 'deploy' } }
            steps {
                sh '''
                    set -e
                    kubectl -n "$NS" rollout status deploy/api-gateway --timeout=300s
                    kubectl -n "$NS" run smoke-${BUILD_NUMBER} --rm -i --restart=Never --image=curlimages/curl -- \
                      curl -fsS http://api-gateway/actuator/health
                '''
            }
        }

        stage('Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh '''
                        set +e
                        aws eks update-kubeconfig --name "${PROJECT}-${ENVIRONMENT}" --region "$AWS_REGION"
                        helm uninstall shop -n "$NS"
                        kubectl delete namespace "$NS"
                        set -e
                        cd infra/terraform
                        ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                        cat > backend.tf <<EOT
terraform {
  backend "s3" {
    bucket         = "${PROJECT}-tfstate-${ACCOUNT_ID}"
    key            = "${ENVIRONMENT}/terraform.tfstate"
    region         = "${AWS_REGION}"
    dynamodb_table = "${PROJECT}-tflock"
  }
}
EOT
                        terraform init -reconfigure -input=false
                        terraform destroy -auto-approve -input=false \
                          -var="region=${AWS_REGION}" -var="environment=${ENVIRONMENT}" \
                          -var="manage_data=${MANAGE_DATA}" -var="db_password=${DB_PASSWORD}"
                    '''
                }
            }
        }
    }

    post {
        success { echo "ACTION=${params.ACTION} complete for ${NS} (tag ${TAG})." }
        failure { echo "Pipeline failed — check the failing stage's log." }
    }
}
